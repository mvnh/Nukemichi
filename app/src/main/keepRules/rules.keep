# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# kotlinx.serialization: XrayConfigModels/XrayVpnProfile/etc. are serialized via reflection on
# generated `serializer()` companions — R8 strips these without explicit keep rules.
# https://github.com/Kotlin/kotlinx.serialization/blob/master/rules/common.pro
-keepattributes *Annotation*, InnerClasses
-dontnote kotlinx.serialization.AnnotationsKt

-keepclassmembers class kotlinx.serialization.json.** {
    *** Companion;
}
-keepclasseswithmembers class kotlinx.serialization.json.** {
    kotlinx.serialization.KSerializer serializer(...);
}

-keep,includedescriptorclasses class app.nukemichi.android.**$$serializer { *; }
-keepclassmembers class app.nukemichi.android.** {
    *** Companion;
}
-keepclasseswithmembers class app.nukemichi.android.** {
    kotlinx.serialization.KSerializer serializer(...);
}

# gRPC + Protobuf-lite: xray-core's generated API stubs (StatsService/HandlerService/
# LoggerService, used by XrayGrpcApi) and the grpc-okhttp transport.
-keep class com.xray.** { *; }
-keep class * extends com.google.protobuf.GeneratedMessageLite { *; }
-keep class io.grpc.** { *; }
-dontwarn io.grpc.**
-dontwarn com.google.protobuf.**
-dontwarn javax.annotation.**

# sshj + Bouncy Castle: reflection-based provider/algorithm lookup for SSH auth/crypto.
-keep class net.schmizz.** { *; }
-dontwarn net.schmizz.**
-keep class org.bouncycastle.** { *; }
-dontwarn org.bouncycastle.**

# hev-socks5-tunnel's native JNI_OnLoad does FindClass() by the hardcoded package/class name
# baked into Android.mk's PKGNAME cFlag — R8 renaming this class breaks that lookup with
# JNI_ERR at library load (native code has no way to see through obfuscation).
-keep class app.nukemichi.android.core.vpn.internal.TProxyService { *; }
